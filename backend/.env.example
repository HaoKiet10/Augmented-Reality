# Database — local dev dùng Postgres trong Docker (`docker compose up -d` ở thư mục gốc repo).
# Production (Render) đặt 2 biến này trỏ tới Supabase. KHÔNG trỏ máy local vào DB production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ar_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ar_dev"

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Port
PORT=3000

# CORS: danh sách domain frontend được phép, phân tách bằng dấu phẩy.
# Bỏ trống ở local để dùng mặc định (localhost:5173 + domain Vercel).
CORS_ORIGIN=http://localhost:5173,https://augmented-reality-frontend.vercel.app

# Dùng để build link trong email reset-password (frontend/reset-password?token=...)
# và trang nhận access token sau khi Google OAuth redirect về (frontend/oauth-callback?token=...)
FRONTEND_URL=http://localhost:5173

# Gửi email (reset mật khẩu) qua SMTP — mặc định Gmail (smtp.gmail.com:465).
# SMTP_PASS là App Password 16 ký tự (Google Account > Security > App passwords,
# cần bật 2-Step Verification), KHÔNG phải mật khẩu Gmail.
# Bỏ trống ở local: link reset được in ra log backend ([DEV ONLY]) thay vì gửi.
# Production (NODE_ENV=production) BẮT BUỘC có, không bao giờ in link ra log.
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=
# Tuỳ chọn — chỉ cần khi không dùng Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Tuỳ chọn — tên hiển thị người gửi. Với Gmail, địa chỉ phải là chính SMTP_USER.
# Bỏ trống = "AR Studio <SMTP_USER>".
# MAIL_FROM="AR Studio <your_gmail@gmail.com>"

# Google OAuth — tạo tại Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorized redirect URI phải khớp CHÍNH XÁC
# với GOOGLE_CALLBACK_URL bên dưới (http://localhost:3000/auth/google/callback
# khi chạy local; đổi sang domain Render thật khi deploy).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback