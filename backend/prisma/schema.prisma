// Prisma Schema for Augmented Reality Project
// Models for Users, Projects, Assets, and Configurations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  role      String    @default("designer") // designer, admin
  avatarUrl String? // URL to profile picture in Supabase Storage
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  assets    Asset[]
  refreshTokens RefreshToken[]
}

// Refresh token records — enables rotation on use and revocation (e.g. on logout,
// reuse detection, or password change), instead of trusting the JWT alone.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of the raw refresh token — never store raw tokens
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// AR Project model
model Project {
  id           String    @id @default(uuid())
  name         String    @default("Untitled")
  description  String?
  status       String    @default("draft") // draft, published, archived
  triggerImage String? // Storage key of trigger image in Supabase Storage
  triggerImageUrl String? // Public URL của trigger image
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastOpenedAt DateTime  @default(now())
  designerId   String
  designer     User      @relation(fields: [designerId], references: [id], onDelete: Cascade)
  assets       Asset[]
}

// Asset model for uploaded files (images, 3D models, etc.)
model Asset {
  id         String   @id @default(uuid())
  filename   String
  fileType   String // MIME type
  fileSize   Int // Size in bytes
  storageKey String // Supabase Storage key/path
  url        String // Public URL from Supabase CDN
  transform  Json? // AR spatial transform for this asset: { position, rotation, scale }
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy String // User ID who uploaded
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// Configuration model for app-wide settings
model Configuration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
